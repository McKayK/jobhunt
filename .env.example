# Copy to .env and edit. Used by docker compose. Everything here except the
# API keys only seeds defaults on a brand-new database — after that, the
# app's Settings panel owns them.
HOME_ZIP=84042
RADIUS_MILES=30
INCLUDE_REMOTE=1
KEEP_UNKNOWN_LOCATIONS=1
TITLE_INCLUDE=
TITLE_EXCLUDE=intern,internship,vice president,chief

# Nominatim (geocoding fallback) asks for a real contact string.
USER_AGENT=jobhunt/0.3 (personal job search; contact: you@example.com)

# How often the scheduler container refreshes (minutes).
REFRESH_EVERY_MINUTES=120

# Optional — AI resume tailoring. Either one works.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
